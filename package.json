{
	"name": "improviser1999",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#lib/i18n/resolver": {
			"browser": "./src/lib/i18n/resolver/browser.js",
			"default": "./src/lib/i18n/resolver/server.js"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"fmt": "dprint fmt",
		"deploy": "yarn run build && wrangler deploy"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@floating-ui/dom": "^1.8.0",
		"@fontsource/work-sans": "^5.3.0",
		"@iconify-json/ri": "^1.2.10",
		"@iconify/tailwind4": "1.2.3",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.3",
		"@types/negotiator": "^0.6.5",
		"@types/node": "^24",
		"compare-versions": "^6.1.1",
		"dexie": "^4.4.6",
		"dprint": "^0.59.0",
		"eslint": "^10.12.0",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-svelte": "^3.23.0",
		"fonteditor-core": "^2.6.3",
		"globals": "^17.13.0",
		"negotiator": "^1.1.0",
		"overlayscrollbars": "^2.16.0",
		"overlayscrollbars-svelte": "^0.5.5",
		"postgres": "^3.4.9",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"valibot": "^1.5.0",
		"vite": "^8.3.2",
		"vite-plugin-devtools-json": "^1.1.0",
		"wrangler": "^4.147.0"
	},
	"packageManager": "yarn@4.13.0"
}
